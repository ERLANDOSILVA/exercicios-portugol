algoritmo "subitracao"
var
n1, n2, resultado: inteiro
inicio
    escreva("digite o primeiro numero: ")
    leia(n1)
    escreva("digite o segundo numero : ")
    leia(n2)
    resultado <- n1 -n2
    escreva(" A subitracao entre os numeros n1 - n2 e : ", resultado)
    fimalgoritmo







