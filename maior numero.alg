algoritmo "maior numero"
var
n1, n2: real
inicio
escreval("digite o primeiro numero ")
leia(n1)
escreval("digite o segundo numero ")
leia(n2)
se n1 > n2 entao
escreval("O primeiro numero e maior ")
senao 
se n2 > n1 entao 
escreval("O segundo numero e maior ")
senao
escreval("Os dois numeros sao iguais ")
fimse
fimse
fimalgoritmo