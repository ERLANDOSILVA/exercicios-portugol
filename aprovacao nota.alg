algoritmo"aprovacao nota escolar"
var
nota1, nota2, media: real
inicio
escreva("digite a primeira nota: ")
leia(nota1)
escreva("digite a segunda nota:  ")
leia(nota2)
media <- nota1 + nota2 / 2
se media >= 7 entao 
    escreva("aprovado")
senao
    escreva("reprovado")
    fimse
    fimse
    fimse
fimalgoritmo