algoritmo "aniversario stephany"
var
  ano_atual: inteiro
  ano_nascimento: inteiro
  idade: inteiro
inicio
  escreva("digite o ano atual: ")
  leia(ano_atual)
  escreva("ano de nascimento: ")
  leia(ano_nascimento)
  idade<-ano_atual - ano_nascimento
  escreva("a minha idade e ", idade)
  

fimalgoritmo
